# Copy to .env and adjust. Everything prefixed VITE_ is bundled into the browser
# build and is PUBLIC. Never put secrets or private credentials in a VITE_ variable.

# ---------- Frontend ----------

# Registrar selected when the page opens: "kfintech" or "mufg" (MUFG Intime).
# Users can switch in the form. MUFG Intime always goes through the proxy below.
VITE_REGISTRAR=kfintech

# "direct" (default): the browser calls the KFintech endpoint itself, exactly like
#                     https://ipostatus.kfintech.com/ does. Requires the API to allow
#                     your origin via CORS.
# "proxy":            the browser calls the optional Express proxy in /server.
#                     Use only if KFintech permits server-side access.
VITE_IPO_API_MODE=direct

# Direct-mode endpoint (must be https://). The PAN is sent in the "reqparam"
# header and the IPO identifier in the "client_id" header.
VITE_IPO_API_URL=https://0uz601ms56.execute-api.ap-south-1.amazonaws.com/prod/api/query?type=pan

# Proxy-mode endpoint (relative path is fine; Vite dev server forwards /api to :8787).
VITE_IPO_PROXY_URL=/api/ipo-status

# Client-side request timeout in milliseconds.
VITE_IPO_API_TIMEOUT_MS=20000

# Pause between requests when checking several PANs (milliseconds). PANs are
# checked one at a time; 1500 ms means about 40 PANs per minute.
VITE_BULK_DELAY_MS=1500

# Optional: override a registrar's IPO list (JSON array of {"clientId", "name"}).
# Defaults to the list in that registrar's adapter; MUFG Intime loads its list
# live through the proxy. VITE_IPO_LIST is an alias for VITE_IPO_LIST_KFINTECH.
# VITE_IPO_LIST_KFINTECH=[{"clientId":"78061126051","name":"JIO PLATFORMS LIMITED"}]
# VITE_IPO_LIST_MUFG=[{"clientId":"11968","name":"Paras Healthcare Limited - IPO"}]

# ---------- Optional Express proxy (server/index.js) ----------
PORT=8787
# Upstream URL per registrar (each registrar has its own contract; see src/registrars/).
KFIN_API_URL=https://0uz601ms56.execute-api.ap-south-1.amazonaws.com/prod/api/query?type=pan
# MUFG Intime page-method base. A method URL such as .../IPO.aspx/SearchOnPan also works.
MUFG_API_URL=https://in.mpms.mufg.com/Initial_Offer/IPO.aspx/SearchOnPan
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
# How long the proxy reuses a registrar's live IPO list (ms). 0 = refetch every time.
IPO_LIST_CACHE_MS=300000
UPSTREAM_TIMEOUT_MS=15000
